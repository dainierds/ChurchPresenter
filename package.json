{
  "name": "church-presenter",
  "version": "1.4.3",
  "description": "Church presentation software for Windows",
  "main": "./out/main/index.js",
  "author": "ChurchPresenter Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node -e \"const fs=require('fs'); fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'out/main/sql-wasm.wasm');\"",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx && node scripts/verify-test-assertions.js",
    "test": "vitest run",
    "verify": "tsc --noEmit -p tsconfig.json && eslint . --ext .ts,.tsx && vitest run",
    "verify:full": "node scripts/run-verify-full.js",
    "benchmark": "node scripts/benchmark-5000-songs.js",
    "e2e": "node scripts/run-e2e.js",
    "soak": "node scripts/run-soak.js",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "adm-zip": "^0.6.1",
    "electron-log": "^5.2.4",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.12.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/acme-client": "^3.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.1",
    "playwright": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
